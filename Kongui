		for _, player in Players:GetPlayers() do
			if player ~= localPlayer and player.Character and isValidCharacter(player.Character) then
				if espEnabled then
					getOrCreateHighlight(player.Character, player)
					getOrCreateBillboard(player.Character, player)
					updateBillboardText(player)
				else
					removeHighlight(player)
					removeBillboard(player)
				end
			else
				removeHighlight(player)
				removeBillboard(player)
			end
		end
	end
	
	local function enableESP()
		espEnabled = true
