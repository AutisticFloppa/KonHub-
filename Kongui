		keyLabel.Position = UDim2.new(0, 10, 0, 40)
		keyLabel.BackgroundTransparency = 1
		keyLabel.Font = Enum.Font.SourceSans
		keyLabel.TextSize = 18
		keyLabel.TextXAlignment = Enum.TextXAlignment.Left
		keyLabel.ZIndex = 11
		keyLabel.Parent = frame
	
		changeKeyButton = Instance.new("TextButton")
		changeKeyButton.Size = UDim2.new(0, 120, 0, 30)
		changeKeyButton.Position = UDim2.new(0, 10, 0, 80)
		changeKeyButton.BackgroundColor3 = Color3.new(0, 0, 0)
		changeKeyButton.BorderSizePixel = 1
		changeKeyButton.Text = "Change Key"
		changeKeyButton.Font = Enum.Font.SourceSans
		changeKeyButton.TextSize = 18
		changeKeyButton.ZIndex = 11
		changeKeyButton.Parent = frame
	
		showHideLabel = Instance.new("TextLabel")
		showHideLabel.Size = UDim2.new(0, 120, 0, 30)
		showHideLabel.Position = UDim2.new(1, -130, 0, 80)
		showHideLabel.BackgroundTransparency = 1
		showHideLabel.Font = Enum.Font.SourceSans
		showHideLabel.TextSize = 14
		showHideLabel.ZIndex = 11
		showHideLabel.Text = "       Press K to show/hide"
		showHideLabel.Parent = frame
	
		changeKeyButton.MouseButton1Click:Connect(function()
			if not enabled then return end
			if listeningForKey then return end
			listeningForKey = true
			changeKeyButton.Text = "Press any key..."
			keyLabel.Text = "Current Key: ..."
		end)
	end
	
	-- Rainbow color animation
	local function updateRainbowColors()
		local hue = 0
		RunService.RenderStepped:Connect(function()
			hue = (hue + 0.005) % 1
			local color = Color3.fromHSV(hue, 1, 1)
			if frame then
				frame.BorderColor3 = color
			end
			if changeKeyButton then
				changeKeyButton.BorderColor3 = color
				changeKeyButton.TextColor3 = color
			end
			if keyLabel then
				keyLabel.TextColor3 = color
			end
			if rainbowTitleLabel then
				rainbowTitleLabel.TextColor3 = color
			end
			if showHideLabel then
				showHideLabel.TextColor3 = color
			end
		end)
	end
	
	updateRainbowColors()
	
	local function getClosestTarget()
		local closestPart = nil
		local closestDist = math.huge
		local rayParams = RaycastParams.new()
		rayParams.FilterType = Enum.RaycastFilterType.Blacklist
		rayParams.IgnoreWater = true
	
		for _, player in Players:GetPlayers() do
			if player ~= localPlayer and player.Character and player.Character.Parent == workspace then
				if not player.Team or not localPlayer.Team or player.Team ~= localPlayer.Team then
					local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
					if humanoid and humanoid.Health > 0 then
						local partsToCheck = {
							player.Character:FindFirstChild("Head"),
							player.Character:FindFirstChild("Torso"),
							player.Character:FindFirstChild("UpperTorso"),
							player.Character:FindFirstChild("HumanoidRootPart")
						}
						for _, part in partsToCheck do
							if part then
								-- Raycast from camera to part to check visibility
								rayParams.FilterDescendantsInstances = {localPlayer.Character}
								local origin = camera.CFrame.Position
								local direction = (part.Position - origin)
								local raycastResult = workspace:Raycast(origin, direction, rayParams)
	
								-- If raycast hits something not the target character, skip this part
								if raycastResult and raycastResult.Instance then
									local hitParent = raycastResult.Instance:FindFirstAncestorOfClass("Model")
									if hitParent ~= player.Character then
										continue
									end
								end
	
								local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
								if onScreen then
									local dist = (camera.CFrame.Position - part.Position).Magnitude
									if dist < closestDist then
										closestDist = dist
										closestPart = part
									end
								end
							end
						end
					end
				end
			end
		end
		return closestPart
	end
	
	local function startAimbot()
		if aimConnection then return end
		aimConnection = RunService.RenderStepped:Connect(function()
			local targetPart = getClosestTarget()
			if targetPart then
				local camPos = camera.CFrame.Position
				local currentLook = camera.CFrame.LookVector
				local desiredLook = (targetPart.Position - camPos).Unit
				local smoothness = 0.18
				local newLook = currentLook:Lerp(desiredLook, smoothness)
				if newLook.Magnitude > 0.01 then
					camera.CFrame = CFrame.new(camPos, camPos + newLook)
				end
			end
		end)
	end
	
	local function stopAimbot()
		if aimConnection then
			aimConnection:Disconnect()
			aimConnection = nil
		end
	end
	
	local function setNonTitleLabelColors()
		-- Intentionally blank, rainbow overrides these
	end
	
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
	
		if input.KeyCode == Enum.KeyCode.K then
			if not gui or not frame then
				createKeybindFrame()
			end
			frame.Visible = not frame.Visible
			enabled = frame.Visible
			stopAimbot()
			aimbotActive = false
			listeningForKey = false
			if keyLabel then
				keyLabel.Text = "Current Key: " .. tostring(currentKeyCode.Name)
			end
			if changeKeyButton then
				changeKeyButton.Text = "Change Key"
			end
			setNonTitleLabelColors()
			return
		end
	
		if listeningForKey then
			if input.KeyCode ~= Enum.KeyCode.Unknown then
				currentKeyCode = input.KeyCode
				if keyLabel then
