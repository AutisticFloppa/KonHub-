local function MZGPGNN_fake_script() -- Aimbot.KONAIMBOT (legacy) 
	local script = Instance.new('LocalScript', Aimbot)

	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	local localPlayer = Players.LocalPlayer
	local camera = workspace.CurrentCamera
	
	local aimbotButton = script.Parent
	
	local currentKeyCode = Enum.KeyCode.E
	local listeningForKey = false
	local enabled = false
	local aimbotActive = false
	local aimConnection = nil
	
	local gui = nil
	local frame = nil
	local keyLabel = nil
	local changeKeyButton = nil
	local rainbowTitleLabel = nil
	local showHideLabel = nil
	
	local function destroyExistingAimbotGui()
		local playerGui = localPlayer:FindFirstChild("PlayerGui")
		if playerGui then
			local existing = playerGui:FindFirstChild("AimbotKeybindGui")
			if existing then
				existing:Destroy()
			end
		end
	end
	
	local function createKeybindFrame()
		if gui then return end
		destroyExistingAimbotGui()
		gui = Instance.new("ScreenGui")
		gui.Name = "AimbotKeybindGui"
		gui.ResetOnSpawn = false
		gui.Parent = localPlayer:WaitForChild("PlayerGui")
	
		frame = Instance.new("Frame")
		frame.Size = UDim2.new(0, 250, 0, 120)
		frame.Position = UDim2.new(0.5, -125, 0.5, -60)
		frame.BackgroundColor3 = Color3.new(0, 0, 0)
