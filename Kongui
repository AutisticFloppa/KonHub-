				local rainbowColor = Color3.fromHSV(hue, 1, 1)
				label.TextColor3 = rainbowColor
			end)
	
		else
			label.Text = "Friendly"
			label.TextColor3 = Color3.new(0, 0.101961, 1)
		end
	end
	
	local function updateESP()
		for _, player in Players:GetPlayers() do
			if player ~= localPlayer and player.Character and isValidCharacter(player.Character) then
				if espEnabled then
					getOrCreateHighlight(player.Character, player)
					getOrCreateBillboard(player.Character, player)
					updateBillboardText(player)
				else
					removeHighlight(player)
					removeBillboard(player)
				end
			else
				removeHighlight(player)
				removeBillboard(player)
			end
		end
	end
	
	local function enableESP()
		espEnabled = true
		updateESP()
		-- Animate rainbow
		if not rainbowConnection then
			rainbowConnection = RunService.RenderStepped:Connect(function()
				local t = (tick() % 6) / 6
				local r, g, b = hsvToRgb(t, 1, 1)
				local color = Color3.new(r, g, b)
				for player, highlight in highlights do
					if highlight and highlight.Parent and highlight.Adornee and isValidCharacter(highlight.Adornee) then
						highlight.OutlineColor = color
					else
						-- Clean up invalid highlights
						removeHighlight(player)
					end
				end
			end)
		end
		-- Visual indicator: change button text
		if button:IsA("TextButton") then
			button.Text = "Homosexual ESP (Disable)"
		end
	end
	
	local function disableESP()
		espEnabled = false
		if rainbowConnection then
			rainbowConnection:Disconnect()
			rainbowConnection = nil
		end
		for _, highlight in highlights do
			if highlight then
				highlight:Destroy()
			end
		end
		highlights = {}
		for _, billboard in billboards do
			if billboard then
				billboard:Destroy()
			end
		end
		billboards = {}
		-- Visual indicator: change button text
		if button:IsA("TextButton") then
			button.Text = "Homosexual ESP (Enable)"
		end
	end
	
	local function onCharacterAdded(player, character)
		if espEnabled and player ~= localPlayer and isValidCharacter(character) then
			getOrCreateHighlight(character, player)
			getOrCreateBillboard(character, player)
			updateBillboardText(player)
		else
			removeHighlight(player)
			removeBillboard(player)
		end
	end
	
	local function onPlayerAdded(player)
		if player == localPlayer then return end
		player.CharacterAdded:Connect(function(character)
			onCharacterAdded(player, character)
		end)
		-- If the character already exists (player joined before script ran)
		if player.Character then
			onCharacterAdded(player, player.Character)
		end
	end
	
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(function(player)
		removeHighlight(player)
		removeBillboard(player)
	end)
	
	button.MouseButton1Click:Connect(function()
		if espEnabled then
			disableESP()
		else
			enableESP()
		end
	end)
	
	-- Set initial button state
	if button:IsA("TextButton") then
		button.Text = "Homosexual ESP (Enable)"
		button.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	end
	disableESP()
	
	-- Clean up on script removal
	script.AncestryChanged:Connect(function()
		if not script:IsDescendantOf(game) then
			disableESP()
		end
	end)
	
	-- Extra: Update ESP on team change (if teams are used)
	if localPlayer:GetPropertyChangedSignal("Team") then
		localPlayer:GetPropertyChangedSignal("Team"):Connect(function()
			if espEnabled then
				updateESP()
			end
		end)
	end
	Players.PlayerAdded:Connect(function(player)
		if player:GetPropertyChangedSignal("Team") then
			player:GetPropertyChangedSignal("Team"):Connect(function()
				if espEnabled then
					updateESP()
				end
			end)
		end
	end)
	
	-- Update Billboard text if teams change
	for _, player in Players:GetPlayers() do
		if player:GetPropertyChangedSignal("Team") then
			player:GetPropertyChangedSignal("Team"):Connect(function()
				updateBillboardText(player)
			end)
		end
	end
	Players.PlayerAdded:Connect(function(player)
		if player:GetPropertyChangedSignal("Team") then
			player:GetPropertyChangedSignal("Team"):Connect(function()
				updateBillboardText(player)
			end)
		end
	end)
	
	
end
