	updateRainbowColors()
	
	local function getClosestTarget()
		local closestPart = nil
		local closestDist = math.huge
		local rayParams = RaycastParams.new()
		rayParams.FilterType = Enum.RaycastFilterType.Blacklist
		rayParams.IgnoreWater = true
	
		for _, player in Players:GetPlayers() do
			if player ~= localPlayer and player.Character and player.Character.Parent == workspace then
				-- Use teamCheckEnabled to determine if we check teams
				if (not teamCheckEnabled) or (not player.Team or not localPlayer.Team or player.Team ~= localPlayer.Team) then
					local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
					if humanoid and humanoid.Health > 0 then
						local partsToCheck = {
							player.Character:FindFirstChild("Head"),
							player.Character:FindFirstChild("Torso"),
							player.Character:FindFirstChild("UpperTorso"),
							player.Character:FindFirstChild("HumanoidRootPart")
						}
						for _, part in partsToCheck do
							if part then
								rayParams.FilterDescendantsInstances = {localPlayer.Character}
								local origin = camera.CFrame.Position
								local direction = (part.Position - origin)
								local raycastResult = workspace:Raycast(origin, direction, rayParams)
	
								if raycastResult and raycastResult.Instance then
									local hitParent = raycastResult.Instance:FindFirstAncestorOfClass("Model")
									if hitParent ~= player.Character then
										continue
									end
								end
	
								local _, onScreen = camera:WorldToViewportPoint(part.Position)
								if onScreen then
									local dist = (camera.CFrame.Position - part.Position).Magnitude
									if dist < closestDist then
										closestDist = dist
										closestPart = part
									end
								end
							end
						end
					end
				end
			end
		end
		return closestPart
	end
	
	local function startAimbot()
		if aimConnection then return end
		aimConnection = RunService.RenderStepped:Connect(function()
			local targetPart = getClosestTarget()
			if targetPart then
				local camPos = camera.CFrame.Position
				local currentLook = camera.CFrame.LookVector
				local desiredLook = (targetPart.Position - camPos).Unit
				local smoothness = 0.18
				local newLook = currentLook:Lerp(desiredLook, smoothness)
				if newLook.Magnitude > 0.01 then
					camera.CFrame = CFrame.new(camPos, camPos + newLook)
				end
			end
		end)
	end
	
	local function stopAimbot()
		if aimConnection then
			aimConnection:Disconnect()
			aimConnection = nil
		end
	end
	
