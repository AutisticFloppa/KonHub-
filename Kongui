			label.Size = UDim2.new(1, 0, 1, 0)
			label.BackgroundTransparency = 1
			label.TextStrokeTransparency = 0.5
			label.TextScaled = true
			label.Font = Enum.Font.SourceSans
			label.Parent = billboard
	
			billboards[player] = billboard
		end
		return billboards[player]
	end
	
	local function removeBillboard(player)
		if billboards[player] then
			billboards[player]:Destroy()
			billboards[player] = nil
		end
	end
	
	local function updateBillboardText(player)
		local billboard = billboards[player]
		if not billboard then return end
		local label = billboard:FindFirstChild("StatusLabel")
		if not label then return end
		if isEnemy(player) then
			label.Text = "Enemy"
			label.TextColor3 = Color3.new(0.701961, 0, 1)
		else
			label.Text = "Friendly"
			label.TextColor3 = Color3.new(0, 0.101961, 1)
		end
	end
	
