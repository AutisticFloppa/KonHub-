local function MFAE_fake_script() -- HomoESP.KON esp test 
	local script = Instance.new('LocalScript', HomoESP)

	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local localPlayer = Players.LocalPlayer
	
	local button = HomoESP
	
	local espEnabled = false
	local highlights = {} -- [Player] = Highlight
	local billboards = {} -- [Player] = BillboardGui
	local rainbowConnection = nil
	
	-- Helper: HSV to RGB
	local function hsvToRgb(h, s, v)
		local i = math.floor(h * 6)
		local f = h * 6 - i
		local p = v * (1 - s)
		local q = v * (1 - f * s)
		local t = v * (1 - (1 - f) * s)
		i = i % 6
		if i == 0 then return v, t, p
		elseif i == 1 then return q, v, p
		elseif i == 2 then return p, v, t
		elseif i == 3 then return p, q, v
		elseif i == 4 then return t, p, v
		elseif i == 5 then return v, p, q
		end
	end
	
	local function isValidCharacter(character)
		-- Only highlight player characters that are in Workspace and have a Humanoid
		return character and character:IsDescendantOf(workspace) and character:FindFirstChildOfClass("Humanoid")
	end
	
	local function isEnemy(player)
		-- Returns true if the player is not on the same team as localPlayer
		-- If Teams are not used, treat all other players as enemies
		if player.Team ~= nil and localPlayer.Team ~= nil then
			return player.Team ~= localPlayer.Team
		else
			return player ~= localPlayer
		end
	end
	
	local function getOrCreateHighlight(character, player)
		if not isValidCharacter(character) then
			return nil
		end
		-- Remove old highlight if it's not parented to the current character
		if highlights[player] and highlights[player].Adornee ~= character then
			highlights[player]:Destroy()
			highlights[player] = nil
		end
		-- Create new highlight if needed
		if not highlights[player] then
			local highlight = Instance.new("Highlight")
			highlight.Adornee = character
			highlight.FillTransparency = 0.7
			highlight.OutlineTransparency = 0
			highlight.OutlineColor = Color3.new(1, 0, 0)
			highlight.Parent = character
			highlights[player] = highlight
		end
		return highlights[player]
	end
	
	local function removeHighlight(player)
		if highlights[player] then
			highlights[player]:Destroy()
			highlights[player] = nil
		end
	end
	
	local function getOrCreateBillboard(character, player)
		if not isValidCharacter(character) then
			return nil
		end
		local head = character:FindFirstChild("Head")
		if not head then
			return nil
		end
		-- Remove old billboard if not parented to the correct head
		if billboards[player] and billboards[player].Adornee ~= head then
			billboards[player]:Destroy()
			billboards[player] = nil
		end
		-- Create new billboard if needed
		if not billboards[player] then
			local billboard = Instance.new("BillboardGui")
			billboard.Name = "ESPStatus"
			billboard.Adornee = head
			billboard.Size = UDim2.new(0, 100, 0, 30)
			billboard.StudsOffset = Vector3.new(0, 2.5, 0)
			billboard.AlwaysOnTop = true
