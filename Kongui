local function QJSTH_fake_script() -- Aimbot.KONAIMBOT (legacy) 
	local script = Instance.new('LocalScript', Aimbot)

	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	local localPlayer = Players.LocalPlayer
	local camera = workspace.CurrentCamera
	
	local aimbotButton = Aimbot
	
	-- Keybind state
	local currentKeyCode = Enum.KeyCode.E
	local listeningForKey = false
	local enabled = false -- Only true after clicking the button and frame is open
	
	local aimbotActive = false -- Whether aimbot is currently toggled on
	local aimConnection = nil
	
	-- UI Setup
	local gui = nil
	local frame = nil
	local keyLabel = nil
	local changeKeyButton = nil
	local rainbowTitleLabel = nil
	local showHideLabel = nil
	
	-- Helper to destroy any existing aimbot GUI before creating a new one
	local function destroyExistingAimbotGui()
