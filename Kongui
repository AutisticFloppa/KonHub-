	local script = Instance.new('LocalScript', NoclipButton)

	local button = script.Parent
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local player = Players.LocalPlayer
	
	local noclipConnection = nil
	local noclipEnabled = false
	
	local function setButtonText()
		if noclipEnabled then
			button.Text = "KON noclip (Disable)"
		else
			button.Text = "KON noclip (Enable)"
		end
	end
	
	local function enableNoclip()
		noclipEnabled = true
		setButtonText()
		noclipConnection = RunService.Stepped:Connect(function()
			local character = player.Character
			if character then
				for k, v in character:GetDescendants() do
					if v:IsA("BasePart") and v.CanCollide then
						v.CanCollide = false
					end
				end
			end
		end)
	end
	
	local function disableNoclip()
		noclipEnabled = false
		setButtonText()
		if noclipConnection then
			noclipConnection:Disconnect()
			noclipConnection = nil
		end
		-- Restore CanCollide for all parts
		local character = player.Character
		if character then
			for k, v in character:GetDescendants() do
				if v:IsA("BasePart") then
					v.CanCollide = true
				end
			end
		end
	end
	
	button.MouseButton1Click:Connect(function()
		if noclipEnabled then
			disableNoclip()
		else
			enableNoclip()
		end
	end)
	
	-- Set initial button text
	setButtonText()
	
	
end
